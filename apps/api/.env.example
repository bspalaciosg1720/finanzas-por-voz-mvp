APP_ENV=development
APP_NAME=Finanzas por Voz API
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://app:change-me@localhost:5432/finanzas
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=["http://localhost:8081"]
PUBLIC_APP_URL=http://localhost:8081
EMAIL_DELIVERY_MODE=file
EMAIL_FROM=no-reply@finanzas.local
