    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitejs/plugin-rsc": "^0.5.26",
    "react-server-dom-webpack": "^19.2.6",
    "typescript": "^5.9.0",
    "vinext": "^1.0.0-beta.4",
    "vite": "^8.2.0",
    "wrangler": "^4.116.0"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "sharp": "^0.35.0"
